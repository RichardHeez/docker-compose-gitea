{
  "name": "f8-scripture-presenter",
  "version": "1.0.0",
  "description": "Modern AI-assisted scripture presentation with voice, all Bible translations and 8 output channels",
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test test/*.test.mjs",
    "desktop": "electron .",
    "dist": "npm run build:secure && electron-builder",
    "dist:win": "npm run build:secure && electron-builder --win",
    "dist:mac": "npm run build:secure && electron-builder --mac",
    "dist:linux": "npm run build:secure && electron-builder --linux",
    "khaya-check": "node scripts/khaya-check.mjs",
    "build:secure": "node scripts/build-secure.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0"
  },
  "optionalDependencies": {
    "@stagetimerio/grandiose": "^0.2.1",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "javascript-obfuscator": "^5.9.0"
  },
  "author": "F8",
  "build": {
    "appId": "app.f8.scripturepresenter",
    "productName": "F8 Scripture Presenter",
    "files": [
      "build/app/**",
      "package.json",
      "node_modules/**",
      "!node_modules/esbuild/**",
      "!node_modules/@esbuild/**",
      "!node_modules/javascript-obfuscator/**"
    ],
    "asarUnpack": [
      "node_modules/@stagetimerio/grandiose/**",
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": "AppImage"
    },
    "extraMetadata": {
      "main": "build/app/desktop/main.mjs"
    },
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  },
  "license": "UNLICENSED",
  "private": true
}
