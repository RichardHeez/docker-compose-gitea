# F8 Cloud settings. Copy to ".env" and fill in. Never commit or share the real .env.

# The public https address of this site (used in emails, payment redirects and cookies)
PUBLIC_URL=https://account.example.com
# Password for the PostgreSQL database (docker-compose creates it)
DB_PASSWORD=change-me-to-a-long-random-password
# Emails that get the /admin page (comma separated)
ADMIN_EMAILS=you@example.com

# Licence signing key (Ed25519, PEM). Leave empty and one is created in the clouddata volume — BACK IT UP.
# Put its public key (shown at /api/license/public-key) into the F8 app build as F8_LICENSE_PUBLIC_KEY.
LICENSE_PRIVATE_KEY=

# Email (verification, password reset, invites, MoMo reminders), e.g. smtps://user:pass@smtp.provider.com:465
SMTP_URL=
MAIL_FROM=F8 Scripture Presenter <no-reply@example.com>

# --- Stripe: card, Bancontact, SEPA Direct Debit (euros, renews automatically) ---
# dashboard.stripe.com → Developers → API keys. Use sk_test_… while testing.
STRIPE_SECRET_KEY=
# Developers → Webhooks → add https://YOUR-SITE/api/webhooks/stripe with events:
#   checkout.session.completed, customer.subscription.created/updated/deleted, invoice.paid
STRIPE_WEBHOOK_SECRET=
# Product catalogue → create products "F8 Pro" and "F8 Ministry", each with a monthly and a yearly price; paste the price ids:
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_MINISTRY_MONTHLY=
STRIPE_PRICE_MINISTRY_YEARLY=
# Optional: the same in US dollars (add USD prices to both products). Churches outside the euro area see dollars by default.
STRIPE_PRICE_PRO_MONTHLY_USD=
STRIPE_PRICE_PRO_YEARLY_USD=
STRIPE_PRICE_MINISTRY_MONTHLY_USD=
STRIPE_PRICE_MINISTRY_YEARLY_USD=
# 1 = charge EU VAT automatically with Stripe Tax (set it up in the Stripe dashboard first; ask your accountant)
STRIPE_AUTOMATIC_TAX=0

# --- Paystack: Mobile Money (MTN, Telecel, AirtelTigo) and cards in cedis, prepaid ---
# dashboard.paystack.com → Settings → API Keys. Webhook URL: https://YOUR-SITE/api/webhooks/paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=GHS

# Prices shown on the site (minor units: cents / pesewas). Stripe charges what its prices say;
# Paystack charges these "ghs" amounts.
# PRICES_JSON={"eur":{"pro":{"month":1900,"year":19000},"ministry":{"month":3500,"year":35000}},"usd":{"pro":{"month":1900,"year":19000},"ministry":{"month":3500,"year":35000}},"ghs":{"pro":{"month":15000,"year":150000},"ministry":{"month":40000,"year":400000}}}

TRIAL_DAYS=14
# How many days an F8 computer keeps working offline before it must check in
LICENSE_DAYS=14
