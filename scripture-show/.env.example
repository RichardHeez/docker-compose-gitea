# Copy this file to ".env" (same folder as docker-compose.yml) and fill in your keys.
# Never commit or share the real .env file.

# Khaya (GhanaNLP) speech-to-text for Akan/Twi, Fante, Ga, Ewe … preachers
KHAYA_API_KEY=

# Optional: Claude AI (catches quoted verses, builds presentations)
ANTHROPIC_API_KEY=

# Optional: PIN required to control the show from other devices
CONTROL_PIN=

# Optional: Planning Center Online (Services) — import your service plans.
# Create a Personal Access Token at https://api.planningcenteronline.com/oauth/applications
PCO_APP_ID=
PCO_SECRET=

# Optional: search & import free motion backgrounds inside F8 (free keys)
# Pexels: https://www.pexels.com/api/   Pixabay: https://pixabay.com/api/docs/
PEXELS_API_KEY=
PIXABAY_API_KEY=
